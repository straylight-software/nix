# // straylight // nix // toolchains
#
# Minimal toolchain definitions for C++ only
#
# All tools come from Nix devshell with absolute Nix store paths.
# Paths are read from .buckconfig.local, generated by shellHook.

load(":cxx.bzl", "llvm_toolchain")
load(":execution.bzl", "lre_execution_platform", "host_configuration")
load("@prelude//toolchains:python.bzl", "system_python_bootstrap_toolchain")
load("@prelude//toolchains:genrule.bzl", "system_genrule_toolchain")
load("@prelude//toolchains:rust.bzl", "system_rust_toolchain")
load("@prelude//tests:test_toolchain.bzl", "noop_test_toolchain")
load(":test.bzl", "noop_remote_test_execution_toolchain")

# ════════════════════════════════════════════════════════════════════════════════
# C++ (LLVM 22) - Default (no coverage)
# ════════════════════════════════════════════════════════════════════════════════

llvm_toolchain(
    name = "cxx",
    c_extra_flags = [
        "-std=c23",
        "-Wall",
        "-Wextra",
    ],
    cxx_extra_flags = [
        "-std=c++23",
        "-Wall",
        "-Wextra",
    ],
    link_flags = [],
    link_style = "static",
    visibility = ["PUBLIC"],
)

# ════════════════════════════════════════════════════════════════════════════════
# C++ (LLVM 22) - Coverage instrumentation
# ════════════════════════════════════════════════════════════════════════════════
#
# Build with: buck2 build --config cxx.toolchain=toolchains//:cxx_coverage //...
#
# Coverage flags:
#   -fprofile-instr-generate: Generate instrumentation for profile collection
#   -fcoverage-mapping: Generate coverage mapping data for llvm-cov
#
# After running tests, use llvm-profdata + llvm-cov to generate reports:
#   llvm-profdata merge -sparse *.profraw -o coverage.profdata
#   llvm-cov report ./binary -instr-profile=coverage.profdata
#   llvm-cov show ./binary -instr-profile=coverage.profdata -format=html -output-dir=coverage/

llvm_toolchain(
    name = "cxx_coverage",
    c_extra_flags = [
        "-std=c23",
        "-Wall",
        "-Wextra",
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
    ],
    cxx_extra_flags = [
        "-std=c++23",
        "-Wall",
        "-Wextra",
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
    ],
    link_flags = [
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
    ],
    link_style = "static",
    visibility = ["PUBLIC"],
)

# ════════════════════════════════════════════════════════════════════════════════
# PYTHON BOOTSTRAP (required by Buck2 internals)
# ════════════════════════════════════════════════════════════════════════════════

system_python_bootstrap_toolchain(
    name = "python_bootstrap",
    visibility = ["PUBLIC"],
)

# ════════════════════════════════════════════════════════════════════════════════
# GENRULE (for custom build rules)
# ════════════════════════════════════════════════════════════════════════════════

system_genrule_toolchain(
    name = "genrule",
    visibility = ["PUBLIC"],
)

# ════════════════════════════════════════════════════════════════════════════════
# EXECUTION PLATFORMS
# ════════════════════════════════════════════════════════════════════════════════

lre_execution_platform(
    name = "lre",
    cpu_configuration = host_configuration.cpu,
    os_configuration = host_configuration.os,
    local_enabled = True,
    remote_enabled = False,
    visibility = ["PUBLIC"],
)

# Local-only execution platform (used by .buckconfig default)
lre_execution_platform(
    name = "local",
    cpu_configuration = host_configuration.cpu,
    os_configuration = host_configuration.os,
    local_enabled = True,
    remote_enabled = False,
    visibility = ["PUBLIC"],
)

# ════════════════════════════════════════════════════════════════════════════════
# TARGET PLATFORMS
# ════════════════════════════════════════════════════════════════════════════════

# Musl target platform for static linking
# Use with: buck2 build --target-platforms=toolchains//:musl //...
#
# This platform sets the musl ABI constraint, which causes the Rust toolchain
# to use x86_64-unknown-linux-musl as the target triple. Proc-macros are still
# built for glibc (via exec transition) because the execution platform (lre)
# does NOT have the musl constraint.
lre_execution_platform(
    name = "musl",
    cpu_configuration = host_configuration.cpu,
    os_configuration = host_configuration.os,
    abi_configuration = "prelude//abi/constraints:musl",
    local_enabled = True,
    remote_enabled = False,
    visibility = ["PUBLIC"],
)

# ════════════════════════════════════════════════════════════════════════════════
# TEST TOOLCHAIN (required for cxx_test)
# ════════════════════════════════════════════════════════════════════════════════

noop_test_toolchain(
    name = "test",
    visibility = ["PUBLIC"],
)

# Stub for remote test execution (we run tests locally only)
noop_remote_test_execution_toolchain(
    name = "remote_test_execution",
    visibility = ["PUBLIC"],
)

# ════════════════════════════════════════════════════════════════════════════════
# RUST TOOLCHAIN (for isospin/third-party rust deps)
# ════════════════════════════════════════════════════════════════════════════════
#
# Uses select() to pick the target triple based on ABI constraint:
# - Default (no ABI constraint): x86_64-unknown-linux-gnu (for proc-macros running in rustc)
# - config//abi:musl: x86_64-unknown-linux-musl (for target builds linked into musl binary)
#
# This enables cross-compilation where:
# - Proc-macros are built for the host (glibc) to run inside rustc
# - Target libraries are built for musl to link into the final static binary

system_rust_toolchain(
    name = "rust",
    default_edition = "2021",
    rustc_target_triple = select({
        "DEFAULT": "x86_64-unknown-linux-gnu",
        "config//abi:musl": "x86_64-unknown-linux-musl",
    }),
    visibility = ["PUBLIC"],
)
