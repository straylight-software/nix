# // straylight // nix // Buck2 Configuration
#
# Hermetic builds with Nix store paths.
# Toolchain paths are set in .buckconfig.local (generated by nix develop).

[cells]
root = .
prelude = build/prelude
toolchains = build/toolchains
none = none

[cell_aliases]
config = prelude
ovr_config = prelude
fbcode = none
fbsource = none
fbcode_macros = none
buck = none

[parser]
# Use musl target platform by default - required for Rust/C++ ABI compatibility
# Rust libraries target x86_64-unknown-linux-musl to match C++ musl toolchain
target_platform_detector_spec = target:root//...->toolchains//:musl

[buck2]
materializations = deferred
digest_algorithms = BLAKE3

[build]
execution_platforms = toolchains//:musl
