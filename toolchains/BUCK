# // straylight // nix // toolchains
#
# Minimal toolchain definitions for C++ only
#
# All tools come from Nix devshell with absolute Nix store paths.
# Paths are read from .buckconfig.local, generated by shellHook.

load(":cxx.bzl", "llvm_toolchain")
load(":execution.bzl", "lre_execution_platform", "host_configuration")
load("@prelude//toolchains:python.bzl", "system_python_bootstrap_toolchain")
load("@prelude//toolchains:genrule.bzl", "system_genrule_toolchain")
load("@prelude//tests:test_toolchain.bzl", "noop_test_toolchain")
load(":test.bzl", "noop_remote_test_execution_toolchain")

# ════════════════════════════════════════════════════════════════════════════════
# C++ (LLVM 22) - Default (no coverage)
# ════════════════════════════════════════════════════════════════════════════════

llvm_toolchain(
    name = "cxx",
    c_extra_flags = [
        "-std=c23",
        "-Wall",
        "-Wextra",
    ],
    cxx_extra_flags = [
        "-std=c++23",
        "-Wall",
        "-Wextra",
    ],
    link_flags = [],
    link_style = "static",
    visibility = ["PUBLIC"],
)

# ════════════════════════════════════════════════════════════════════════════════
# C++ (LLVM 22) - Coverage instrumentation
# ════════════════════════════════════════════════════════════════════════════════
#
# Build with: buck2 build --config cxx.toolchain=toolchains//:cxx_coverage //...
#
# Coverage flags:
#   -fprofile-instr-generate: Generate instrumentation for profile collection
#   -fcoverage-mapping: Generate coverage mapping data for llvm-cov
#
# After running tests, use llvm-profdata + llvm-cov to generate reports:
#   llvm-profdata merge -sparse *.profraw -o coverage.profdata
#   llvm-cov report ./binary -instr-profile=coverage.profdata
#   llvm-cov show ./binary -instr-profile=coverage.profdata -format=html -output-dir=coverage/

llvm_toolchain(
    name = "cxx_coverage",
    c_extra_flags = [
        "-std=c23",
        "-Wall",
        "-Wextra",
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
    ],
    cxx_extra_flags = [
        "-std=c++23",
        "-Wall",
        "-Wextra",
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
    ],
    link_flags = [
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
    ],
    link_style = "static",
    visibility = ["PUBLIC"],
)

# ════════════════════════════════════════════════════════════════════════════════
# PYTHON BOOTSTRAP (required by Buck2 internals)
# ════════════════════════════════════════════════════════════════════════════════

system_python_bootstrap_toolchain(
    name = "python_bootstrap",
    visibility = ["PUBLIC"],
)

# ════════════════════════════════════════════════════════════════════════════════
# GENRULE (for custom build rules)
# ════════════════════════════════════════════════════════════════════════════════

system_genrule_toolchain(
    name = "genrule",
    visibility = ["PUBLIC"],
)

# ════════════════════════════════════════════════════════════════════════════════
# EXECUTION PLATFORMS
# ════════════════════════════════════════════════════════════════════════════════

lre_execution_platform(
    name = "lre",
    cpu_configuration = host_configuration.cpu,
    os_configuration = host_configuration.os,
    local_enabled = True,
    remote_enabled = False,
    visibility = ["PUBLIC"],
)

# ════════════════════════════════════════════════════════════════════════════════
# TEST TOOLCHAIN (required for cxx_test)
# ════════════════════════════════════════════════════════════════════════════════

noop_test_toolchain(
    name = "test",
    visibility = ["PUBLIC"],
)

# Stub for remote test execution (we run tests locally only)
noop_remote_test_execution_toolchain(
    name = "remote_test_execution",
    visibility = ["PUBLIC"],
)
