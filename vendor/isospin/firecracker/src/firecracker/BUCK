        "CARGO_PKG_VERSION": "1.15.0-dev",
    },
    deps = [
        "//vendor/isospin/firecracker/src/utils:utils",
        "//vendor/isospin/firecracker/src/vmm:vmm",
        "//vendor/isospin/third-party/rust:displaydoc",
        "//vendor/isospin/third-party/rust:event-manager",
        "//vendor/isospin/third-party/rust:libc",
        "//vendor/isospin/third-party/rust:micro_http",
