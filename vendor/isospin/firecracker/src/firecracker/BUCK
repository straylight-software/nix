# firecracker - Main binary
#
# The seccomp filter is embedded into the binary via include_bytes!.
# We use a pre-generated BPF file to avoid running seccompiler-bin at build time,
# which has glibc/musl toolchain issues (the glibc version segfaults).

# Copy pre-generated seccomp filter to OUT_DIR structure expected by build.rs
# The prebuilt filter was generated from unimplemented.json (allows all syscalls).
genrule(
    name = "seccomp_filter",
    srcs = [
        "//vendor/isospin/firecracker/resources/seccomp:seccomp_filter.bpf",
    ],
    out = "out",
    cmd = """
        mkdir -p $OUT
        cp $(location //vendor/isospin/firecracker/resources/seccomp:seccomp_filter.bpf) $OUT/seccomp_filter.bpf
    """,
)

rust_binary(
    name = "firecracker",
    srcs = glob(["src/**/*.rs"]),
    crate = "firecracker",
    crate_root = "src/main.rs",
    edition = "2024",
    features = [
        "default",
    ],
    env = {
        "OUT_DIR": "$(location :seccomp_filter)",
        "CARGO_PKG_VERSION": "1.15.0-dev",
    },
    deps = [
        "//vendor/isospin/firecracker/src/utils:utils",
        "//vendor/isospin/firecracker/src/vmm:vmm",
        "//vendor/isospin/third-party/rust:displaydoc",
        "//vendor/isospin/third-party/rust:event-manager",
        "//vendor/isospin/third-party/rust:libc",
        "//vendor/isospin/third-party/rust:micro_http",
        "//vendor/isospin/third-party/rust:serde",
        "//vendor/isospin/third-party/rust:serde_json",
        "//vendor/isospin/third-party/rust:thiserror",
        "//vendor/isospin/third-party/rust:vmm-sys-util",
    ],
    visibility = ["PUBLIC"],
)

# Also build a library target for the lib.rs
