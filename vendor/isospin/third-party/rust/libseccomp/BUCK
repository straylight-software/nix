# libseccomp - Prebuilt static library from Nix (musl static)
#
# This provides the libseccomp C library for the seccompiler crate,
# which uses FFI bindings to compile JSON seccomp policies into BPF.

load("//vendor:nix-deps.bzl", "LIBSECCOMP_STATIC_LIB")
load("//vendor:nix_prebuilt.bzl", "nix_prebuilt_cxx_library")

nix_prebuilt_cxx_library(
    name = "libseccomp",
    static_lib = LIBSECCOMP_STATIC_LIB,
)
