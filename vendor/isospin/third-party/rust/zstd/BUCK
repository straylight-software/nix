# zstd - Prebuilt static library from Nix
#
# This provides the zstd C library for the zstd-sys crate,
# which provides FFI bindings for zstd compression.

load("//vendor:nix-deps.bzl", "ZSTD_STATIC_LIB")
load("//vendor:nix_prebuilt.bzl", "nix_prebuilt_cxx_library")

nix_prebuilt_cxx_library(
    name = "zstd",
    static_lib = ZSTD_STATIC_LIB,
    visibility = ["PUBLIC"],
)
