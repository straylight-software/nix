# vendor/isospin/gpu-broker/BUCK
#
# GPU Broker - Multiplexes NVIDIA RM API calls from multiple VMs
#
# Module hierarchy:
#
#   guest_protocol  - Pure, no_std protocol (wire format, client state)
#                     Can be extracted for kernel module use
#
#   gpu_broker_lib  - Main library crate containing:
#                     - handle_table: Client handle isolation
#                     - rm_api: NVIDIA RM API definitions  
#                     - broker: Pure functional state machine
#                     - transport: Transport trait + simulation
#                     - uring: io_uring event loop
#                     - uring_transport: Shared memory transport
#                     - driver: NVIDIA driver proxy
#                     - proxy: BrokerProxy (coordination layer)
#                     - fd_passing: Unix SCM_RIGHTS utilities
#                     - server: Unix socket server
#                     - vsock: VM vsock server
#                     - nvml_server: nvidia-smi compatibility
#                     - guest_shim: FUSE/CUSE device emulation
#
#   gpu-broker      - Main binary

# =============================================================================
# guest_protocol - Standalone no_std library
# =============================================================================
#
# This is intentionally separate because it's designed to be:
#   1. Used in userspace (broker + tests)
#   2. Compiled as no_std for kernel module (nvidia-shim.ko)
#
# Wire format must stay in sync with kernel/nvidia-shim.c

rust_library(
    name = "guest_protocol",
    srcs = [
        "src/guest_protocol/client.rs",
        "src/guest_protocol/invariants.rs",
        "src/guest_protocol/mod.rs",
        "src/guest_protocol/wire.rs",
    ],
    crate = "guest_protocol",
    crate_root = "src/guest_protocol/mod.rs",
    edition = "2021",
    features = ["std"],
    visibility = ["PUBLIC"],
)

rust_test(
    name = "guest_protocol_test",
    srcs = [
        "src/guest_protocol/client.rs",
        "src/guest_protocol/invariants.rs",
        "src/guest_protocol/mod.rs",
        "src/guest_protocol/tests.rs",
        "src/guest_protocol/wire.rs",
    ],
    crate = "guest_protocol",
    crate_root = "src/guest_protocol/mod.rs",
    edition = "2021",
    features = ["std"],
    deps = [
        "//vendor/isospin/third-party/rust:proptest",
    ],
)

# =============================================================================
# gpu_broker - Main library crate
# =============================================================================
#
# All modules that use `crate::` imports must be in the same crate.
# This is the full broker library with all features enabled.

rust_library(
    name = "gpu_broker_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = [
            "src/guest_protocol/**",
            "src/main.rs",
            "src/bin/**",
        ],
    ),
    crate = "gpu_broker",
    crate_root = "src/lib.rs",
    edition = "2021",
    features = ["tracing"],
    deps = [
        "//vendor/isospin/third-party/rust:io-uring",
        "//vendor/isospin/third-party/rust:libc",
        "//vendor/isospin/third-party/rust:thiserror",
        "//vendor/isospin/third-party/rust:tracing",
        "//vendor/isospin/third-party/rust:zerocopy",
    ],
    visibility = ["PUBLIC"],
)

rust_test(
    name = "gpu_broker_lib_test",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = [
            "src/guest_protocol/**",
            "src/main.rs",
            "src/bin/**",
        ],
    ),
    crate = "gpu_broker",
    crate_root = "src/lib.rs",
    edition = "2021",
    features = ["tracing"],
    deps = [
        "//vendor/isospin/third-party/rust:io-uring",
        "//vendor/isospin/third-party/rust:libc",
        "//vendor/isospin/third-party/rust:proptest",
        "//vendor/isospin/third-party/rust:tempfile",
        "//vendor/isospin/third-party/rust:thiserror",
        "//vendor/isospin/third-party/rust:tracing",
        "//vendor/isospin/third-party/rust:zerocopy",
    ],
)

