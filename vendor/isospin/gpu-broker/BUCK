# =============================================================================
# guest-shim - FUSE/CUSE binary for guest VMs
# =============================================================================
#
# Self-contained binary that connects to broker via shared memory.
# NOTE: Requires tracing + tracing-subscriber to be added to third-party/rust.

# rust_binary(
#     name = "guest-shim",
#     srcs = ["src/bin/guest-shim.rs"],
#     crate_root = "src/bin/guest-shim.rs",
#     edition = "2021",
#     deps = [
#         "//vendor/isospin/third-party/rust:anyhow",
