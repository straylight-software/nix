#         "//vendor/isospin/third-party/rust:tracing-subscriber",
#     ],
#     visibility = ["PUBLIC"],
# )

# =============================================================================
# kernel/nvidia-shim.ko - Kernel module (built with kbuild)
# =============================================================================
#
# This kernel module intercepts NVIDIA ioctls in guest VMs and forwards
# them to the GPU broker on the host via vsock.
#
# Build: make -C kernel/ KDIR=/path/to/kernel/build
#
# NOTE: Wire protocol in nvidia-shim.c duplicates guest_protocol/wire.rs.
# Keep them in sync! Future: compile guest_protocol as no_std static lib.

export_file(
    name = "nvidia-shim.c",
    src = "kernel/nvidia-shim.c",
    visibility = ["PUBLIC"],
)

export_file(
    name = "kernel-makefile",
    src = "kernel/Makefile",
    visibility = ["PUBLIC"],
)

filegroup(
    name = "kernel_sources",
    srcs = [
        "kernel/Makefile",
        "kernel/nvidia-shim.c",
    ],
    visibility = ["PUBLIC"],
)
