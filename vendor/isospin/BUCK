# // straylight // nix // vendor // isospin
#
# Isospin microVM - Firecracker fork with GPU passthrough support.
# Vendored from github:straylight-software/isospin-microvm
#
# Components:
#   - firecracker: Main VMM binary and libraries
#   - gpu-broker: Host-side GPU broker for VFIO passthrough
#   - third-party/rust: Vendored Rust crate dependencies
#
# The Rust vendor directory is generated by Nix from Cargo.lock.
# See flake.nix for the vendoring configuration.

# Re-export main targets for convenience
alias(
    name = "firecracker",
    actual = "//vendor/isospin/firecracker/src/firecracker:firecracker",
    visibility = ["PUBLIC"],
)

alias(
    name = "firecracker_lib",
    actual = "//vendor/isospin/firecracker/src/firecracker:firecracker_lib",
    visibility = ["PUBLIC"],
)

alias(
    name = "jailer",
    actual = "//vendor/isospin/firecracker/src/jailer:jailer",
    visibility = ["PUBLIC"],
)

alias(
    name = "vmm",
    actual = "//vendor/isospin/firecracker/src/vmm:vmm",
    visibility = ["PUBLIC"],
)

alias(
    name = "utils",
    actual = "//vendor/isospin/firecracker/src/utils:utils",
    visibility = ["PUBLIC"],
)

# GPU broker is a separate Cargo project - needs its own BUCK setup
# For now, export the source location
filegroup(
    name = "gpu-broker-src",
    srcs = glob(["gpu-broker/src/**/*.rs"]),
    visibility = ["PUBLIC"],
)

filegroup(
    name = "nvidia-shim-src",
    srcs = ["gpu-broker/kernel/nvidia-shim.c", "gpu-broker/kernel/Makefile"],
    visibility = ["PUBLIC"],
)
