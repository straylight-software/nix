# LibreSSL 4.2.1 - OpenSSL fork focused on simplicity and security
# Built with Buck2 for musl static linking
#
# Three libraries:
#   - crypto: core cryptographic primitives
#   - ssl: TLS implementation
#   - tls: high-level TLS API (libtls)

# ═══════════════════════════════════════════════════════════════════════════════
# Common configuration
# ═══════════════════════════════════════════════════════════════════════════════

LIBRESSL_DEFINES = [
    "-DLIBRESSL_INTERNAL",
    "-DLIBRESSL_CRYPTO_INTERNAL",
    "-DOPENSSL_NO_HW_PADLOCK",
    "-D__BEGIN_HIDDEN_DECLS=",
    "-D__END_HIDDEN_DECLS=",
    # Override LCRYPTO_ALIAS to be a no-op (clang has issues with asm("") at file scope)
    "-DLCRYPTO_ALIAS(x)=",
    "-DLCRYPTO_USED(x)=",
    "-DLCRYPTO_UNUSED(x)=",
    "-DLSSL_ALIAS(x)=",
    "-DLSSL_USED(x)=",
    "-DLSSL_UNUSED(x)=",
    # Linux defines
    "-D_DEFAULT_SOURCE",
    "-D_BSD_SOURCE",
    "-D_POSIX_SOURCE",
    "-D_GNU_SOURCE",
    # Feature detection for musl
    # Note: musl does NOT have arc4random_buf, strlcat, strlcpy, reallocarray, etc.
    # LibreSSL provides compat implementations
    "-DHAVE_ASPRINTF",
    "-DHAVE_FTRUNCATE",
    "-DHAVE_GETDELIM",
    "-DHAVE_GETLINE",
    "-DHAVE_GETOPT",
    # "-DHAVE_REALLOCARRAY",  # musl doesn't have this
    "-DHAVE_STRCASECMP",
    # "-DHAVE_STRLCAT",       # musl doesn't have this
    # "-DHAVE_STRLCPY",       # musl doesn't have this
    "-DHAVE_STRNDUP",
    "-DHAVE_STRNLEN",
    "-DHAVE_STRSEP",
    # "-DHAVE_ARC4RANDOM_BUF",    # musl doesn't have this - use LibreSSL compat
    # "-DHAVE_ARC4RANDOM_UNIFORM",# musl doesn't have this
    "-DHAVE_EXPLICIT_BZERO",
    "-DHAVE_GETENTROPY",
    "-DHAVE_GETPAGESIZE",
    "-DHAVE_MEMMEM",
    "-DHAVE_ENDIAN_H",
    "-DHAVE_ERR_H",
    "-DHAVE_NETINET_IP_H",
    "-DHAVE_CLOCK_GETTIME",
    "-DHAVE_SYSLOG",
    "-DHAVE_GNU_STACK",
    "-DHAVE_GETAUXVAL",
    # x86_64 ELF assembly optimizations
    "-DAES_ASM",
    "-DBSAES_ASM",
    "-DVPAES_ASM",
    "-DOPENSSL_IA32_SSE2",
    "-DOPENSSL_BN_ASM_MONT",
    "-DOPENSSL_BN_ASM_MONT5",
    "-DGHASH_ASM",
    "-DRSA_ASM",
    # OpenSSL directory (for cert.pem location)
    "-DOPENSSLDIR=\"/etc/ssl\"",
    "-DTLS_DEFAULT_CA_FILE=\"/etc/ssl/cert.pem\"",
]

LIBRESSL_FLAGS = [
    "-std=gnu11",  # gnu11 for GCC extensions like asm("") at file scope
    "-D__STDC_HOSTED__=0",  # Use clang's stdatomic.h
    "-fno-strict-aliasing",
    "-Wno-pointer-sign",
    "-w",  # Suppress warnings in third-party code
]

