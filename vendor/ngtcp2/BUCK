# ngtcp2 1.18.0 - QUIC protocol implementation
# Built with Buck2 for musl static linking
#
# Two libraries:
#   - ngtcp2: core QUIC library
#   - ngtcp2_crypto_libressl: LibreSSL crypto backend

# ═══════════════════════════════════════════════════════════════════════════════
# Core ngtcp2 library
# ═══════════════════════════════════════════════════════════════════════════════

cxx_library(
    name = "ngtcp2",
    srcs = [
        "lib/ngtcp2_acktr.c",
        "lib/ngtcp2_addr.c",
        "lib/ngtcp2_balloc.c",
        "lib/ngtcp2_bbr.c",
        "lib/ngtcp2_buf.c",
        "lib/ngtcp2_callbacks.c",
        "lib/ngtcp2_cc.c",
        "lib/ngtcp2_cid.c",
        "lib/ngtcp2_conn.c",
        "lib/ngtcp2_conn_info.c",
        "lib/ngtcp2_conv.c",
        "lib/ngtcp2_crypto.c",
        "lib/ngtcp2_dcidtr.c",
        "lib/ngtcp2_err.c",
        "lib/ngtcp2_frame_chain.c",
        "lib/ngtcp2_gaptr.c",
        "lib/ngtcp2_idtr.c",
        "lib/ngtcp2_ksl.c",
        "lib/ngtcp2_log.c",
        "lib/ngtcp2_map.c",
        "lib/ngtcp2_mem.c",
        "lib/ngtcp2_objalloc.c",
        "lib/ngtcp2_opl.c",
        "lib/ngtcp2_path.c",
        "lib/ngtcp2_pcg.c",
        "lib/ngtcp2_pkt.c",
        "lib/ngtcp2_pmtud.c",
        "lib/ngtcp2_ppe.c",
        "lib/ngtcp2_pq.c",
        "lib/ngtcp2_pv.c",
        "lib/ngtcp2_qlog.c",
        "lib/ngtcp2_range.c",
        "lib/ngtcp2_ratelim.c",
        "lib/ngtcp2_ringbuf.c",
        "lib/ngtcp2_rob.c",
        "lib/ngtcp2_rst.c",
        "lib/ngtcp2_rtb.c",
        "lib/ngtcp2_settings.c",
        "lib/ngtcp2_str.c",
        "lib/ngtcp2_strm.c",
        "lib/ngtcp2_transport_params.c",
        "lib/ngtcp2_unreachable.c",
        "lib/ngtcp2_vec.c",
        "lib/ngtcp2_version.c",
        "lib/ngtcp2_window_filter.c",
    ],
    exported_headers = {
        "ngtcp2/ngtcp2.h": "lib/includes/ngtcp2/ngtcp2.h",
        "ngtcp2/version.h": "lib/includes/ngtcp2/version.h",
    },
    header_namespace = "",
    include_directories = [
        "lib/includes",
        "lib",
    ],
    compiler_flags = [
        "-std=gnu11",
        "-D__STDC_HOSTED__=0",
        "-DBUILDING_NGTCP2",
        "-D_GNU_SOURCE",  # For explicit_bzero in string.h
        "-DHAVE_ARPA_INET_H",
        "-DHAVE_NETINET_IN_H",
        "-DHAVE_UNISTD_H",
        "-DHAVE_ENDIAN_H",
        "-DHAVE_BYTESWAP_H",
        "-DHAVE_EXPLICIT_BZERO",
        "-DHAVE_DECL_BE64TOH=1",
        "-DHAVE_DECL_BSWAP_64=1",
        "-w",
    ],
    preferred_linkage = "static",
    visibility = ["PUBLIC"],
)

# ═══════════════════════════════════════════════════════════════════════════════
# LibreSSL crypto backend for ngtcp2
# ═══════════════════════════════════════════════════════════════════════════════

cxx_library(
    name = "ngtcp2_crypto_libressl",
    srcs = [
        "crypto/shared.c",
        "crypto/quictls/quictls.c",
    ],
    exported_headers = {
        "ngtcp2/ngtcp2_crypto.h": "crypto/includes/ngtcp2/ngtcp2_crypto.h",
        "ngtcp2/ngtcp2_crypto_quictls.h": "crypto/includes/ngtcp2/ngtcp2_crypto_quictls.h",
    },
    header_namespace = "",
    include_directories = [
        "crypto/includes",
        "crypto",
        "lib/includes",
        "lib",
    ],
    compiler_flags = [
        "-std=c11",
        "-D__STDC_HOSTED__=0",
        "-DBUILDING_NGTCP2",
        "-DBUILDING_NGTCP2_CRYPTO",
        "-DHAVE_ARPA_INET_H",
        "-DHAVE_NETINET_IN_H",
        "-w",
    ],
    deps = [
        ":ngtcp2",
        "//vendor/libressl:crypto",
        "//vendor/libressl:ssl",
    ],
    preferred_linkage = "static",
    visibility = ["PUBLIC"],
)
