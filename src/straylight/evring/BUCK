# src/straylight/evring/BUCK
#
# evring: Deterministic async I/O via replay streams
#
# The core insight: async is trivial to test if you model it as a pure
# function on well-defined replay streams.
#
#   State × Event → State × [Operation]
#
# Features:
#   - Machine concept: pure functional state machines
#   - Replay executor: deterministic testing without I/O
#   - io_uring backend: high-performance Linux async I/O
#   - Generator machines: bulk performance with full replayability

cxx_library(
    name = "evring",

    srcs = [
        "bulk.cpp",
        "http2.cpp",
        "io_uring_ring.cpp",
        "tls.cpp",
    ],

    exported_headers = [
        "bulk.h",
        "event.h",
        "evring.h",
        "generators.h",
        "handle.h",
        "http2.h",
        "machine.h",
        "ring.h",
        "tls.h",
    ],

    header_namespace = "straylight/evring",

    compiler_flags = [
        "-std=c++23",
        "-isystem/nix/store/qqjsw1fzand71ajx326r84zgi485mqb8-liburing-2.11-dev/include",
        "-isystem/nix/store/rng85jny3n20891wv7k64pcpi3qwk0cq-libressl-4.1.0-dev/include",
        "-isystem/nix/store/94iqqnx9wkxzx7mgidv1jgi7k906vh89-nghttp2-1.67.1-dev/include",
    ],

    exported_linker_flags = [
        "-L/nix/store/na5bgfmhm6ci0y3v521kcicvkpzbvdyn-liburing-2.11/lib",
        "-luring",
        "-Wl,-rpath,/nix/store/na5bgfmhm6ci0y3v521kcicvkpzbvdyn-liburing-2.11/lib",
        "-L/nix/store/2z2m346rbgnmv8n0q8dyv4acr4b8rxmw-libressl-4.1.0/lib",
        "-ltls",
