        "http3.h",
        "machine.h",
        "reapi.h",
        "ring.h",
        "sigil.h",        # GENERATED from Cornell.Sigil
        "stable_ref.h",
        "tls.h",
        "zmtp.h",         # Handwritten (to be replaced by zmtp_gen.h)
