        # HTTP/1.x parser
        "-isystem/nix/store/gla5mqdh7darzw1ds3jz0dad9i6sgvid-llhttp-9.3.0-dev/include",
        # ngtcp2 with LibreSSL crypto backend
        "-isystem/nix/store/hgryqyq6x196jk18vr6hndf1jh92a3s0-ngtcp2-1.18.0-dev/include",
        # HTTP/3
        "-isystem/nix/store/bcqpmsh9w6xdy7yd81nkaij8g3vmd61g-nghttp3-1.13.1-dev/include",
