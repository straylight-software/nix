# src/straylight/evring/BUCK
#
# evring: Deterministic async I/O via replay streams
#
# The core insight: async is trivial to test if you model it as a pure
# function on well-defined replay streams.
#
#   State × Event → State × [Operation]
#
# Features:
#   - Machine concept: pure functional state machines
#   - Replay executor: deterministic testing without I/O
#   - io_uring backend: high-performance Linux async I/O
#   - Generator machines: bulk performance with full replayability

cxx_library(
    name = "evring",

    srcs = [
        "bulk.cpp",
        "http1.cpp",
        "http2.cpp",
        "http3.cpp",
        "io_uring_ring.cpp",
        "reapi.cpp",
        "tls.cpp",
    ],

    exported_headers = [
        "bulk.h",
        "event.h",
        "evring.h",
        "generators.h",
        "handle.h",
        "http1.h",
        "http2.h",
        "http3.h",
        "machine.h",
        "reapi.h",
        "ring.h",
        "sigil.h",        # GENERATED from Cornell.Sigil
        "stable_ref.h",
        "tls.h",
        "zmtp.h",         # GENERATED from Cornell.Zmtp
    ],

    header_namespace = "straylight/evring",

    compiler_flags = [
        "-std=c++23",
    ],

    # All dependencies vendored for full static TCB
    exported_deps = [
        "//vendor/liburing:liburing",
        "//vendor/libressl:libressl",
        "//vendor/llhttp:llhttp",
        "//vendor/nghttp2:nghttp2",
        "//vendor/ngtcp2:ngtcp2",
        "//vendor/ngtcp2:ngtcp2_crypto_libressl",
        "//vendor/nghttp3:nghttp3",
    ],

    visibility = ["PUBLIC"],
)

