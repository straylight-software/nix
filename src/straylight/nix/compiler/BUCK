# src/straylight/nix/compiler/BUCK
#
# straylight::language — Nix expression parser and WASM compiler
#
# Architecture:
#   Nix source → PEGTL parser → AST → binaryen → WASM module
#
# This is a clean-room implementation designed for AOT compilation,
# not interpretation. The AST types are optimized for WASM codegen.

cxx_library(
    name = "ast",
    exported_headers = [
        "ast/expression.h",
        "ast/symbol_table.h",
    ],
    header_namespace = "straylight/nix/compiler",
    visibility = ["PUBLIC"],
    # header-only library, no deps needed
)

cxx_library(
    name = "parse",
    exported_headers = [
        "parse/actions.h",
        "parse/convert.h",
        "parse/grammar.h",
        "parse/lower.h",
        "parse/parser.h",
        "parse/selector.h",
        "parse/state.h",
        "parse/tree.h",
    ],
    header_namespace = "straylight/nix/compiler",
    visibility = ["PUBLIC"],
    deps = [
        ":ast",
        "//third_party:pegtl",
    ],
)

cxx_library(
    name = "compile",
    srcs = [
        "compile/guard.cpp",
    ],
    exported_headers = [
        "compile/capture.h",
        "compile/compiler.h",
        "compile/guard.h",
        "compile/scope.h",
        "compile/value.h",
        "compile/wasm_types.h",
    ],
    header_namespace = "straylight/nix/compiler",
    visibility = ["PUBLIC"],
    exported_deps = [
        ":ast",
        "//third_party:binaryen",
    ],
)

cxx_library(
    name = "eval",
    exported_headers = [
        "eval/eval.h",
        "eval/value.h",
    ],
    header_namespace = "straylight/nix/compiler",
    visibility = ["PUBLIC"],
    deps = [
        ":ast",
    ],
)

cxx_library(
    name = "log",
    exported_headers = ["log.h"],
    header_namespace = "straylight/nix/compiler",
    visibility = ["PUBLIC"],
    exported_deps = [
        "//third_party:spdlog",
    ],
)

cxx_library(
    name = "runtime",
    srcs = ["runtime/runtime.cpp"],
    exported_headers = [
        "runtime/io_backend.h",
        "runtime/io_config.h",
        "runtime/memory_layout.h",
        "runtime/result.h",
        "runtime/runtime.h",
        "runtime/wasm_memory.h",
    ],
    header_namespace = "straylight/nix/compiler",
    visibility = ["PUBLIC"],
    compiler_flags = [
        "-std=c++23",
        # Enable sync I/O backend for import, readFile, etc.
        "-DSTRAYLIGHT_EVAL_IO_SYNC=1",
    ],
    deps = [
        ":compile",  # for wasm_types.hh
        ":log",      # for structured logging
    ],
)

# WASM executor using wasmtime
cxx_library(
    name = "wasm_executor",
    srcs = [
        "runtime/wasm_executor.cpp",
        "runtime/io_backend_sync.cpp",
    ],
    exported_headers = [
        "runtime/wasm_executor.h",
    ],
    header_namespace = "straylight/nix/compiler",
    visibility = ["PUBLIC"],
    compiler_flags = [
        "-std=c++23",
        # Enable sync I/O backend for import, readFile, etc.
        "-DSTRAYLIGHT_EVAL_IO_SYNC=1",
    ],
    exported_deps = [
        ":compile",
        ":runtime",
    ],
    deps = [
        ":log",
        "//src/straylight/nix/crypto:hash",
        "//third_party:wasmtime",
    ],
)

# Full evaluator combining parser, compiler, and executor
cxx_library(
    name = "evaluator",
    srcs = ["evaluator.cpp"],
    exported_headers = ["evaluator.h"],
    header_namespace = "straylight/nix/compiler",
    visibility = ["PUBLIC"],
    compiler_flags = [
        "-std=c++23",
        # Enable sync I/O backend for import, readFile, etc.
        "-DSTRAYLIGHT_EVAL_IO_SYNC=1",
    ],
    deps = [
        ":ast",
        ":compile",
        ":parse",
        ":wasm_executor",
        "//third_party:wasmtime",
    ],
)

# main library combining all components
cxx_library(
    name = "language",
    exported_headers = [],
    header_namespace = "straylight/nix/compiler",
    visibility = ["PUBLIC"],
    deps = [
        ":ast",
        ":compile",
        ":eval",
        ":evaluator",
        ":parse",
        ":runtime",
    ],
)

# CLI for evaluating Nix expressions (tree-walking interpreter)
cxx_binary(
    name = "nix_eval",
    srcs = ["cli/nix_eval.cpp"],
    visibility = ["PUBLIC"],
    deps = [
        ":ast",
        ":eval",
        ":parse",
    ],
)

# CLI for evaluating Nix expressions via WASM
cxx_binary(
    name = "nix_wasm_eval",
    srcs = ["cli/nix_wasm_eval.cpp"],
    visibility = ["PUBLIC"],
    compiler_flags = [
        "-std=c++23",
        # Enable sync I/O backend for import, readFile, etc.
        "-DSTRAYLIGHT_EVAL_IO_SYNC=1",
    ],
    deps = [
        ":evaluator",
        ":runtime",  # for io_config.h
    ],
)
