    srcs = ["ast_test.cpp"],
    deps = LANGUAGE_TEST_DEPS,
    compiler_flags = LANGUAGE_TEST_COMPILER_FLAGS,
    linker_flags = LANGUAGE_LINKER_FLAGS,
    link_style = "static",
)

