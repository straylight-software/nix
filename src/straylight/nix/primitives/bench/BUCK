    "-lnanobench",
    "-Wl,-rpath,/nix/store/x5lnx4qwiy1kdlhbnavwqglnlncby1z6-nanobench-4.3.11/lib",
]

# Generic build (baseline, no AVX-512)
cxx_binary(
    name = "strings_bench",
    srcs = ["strings_bench.cpp"],
    compiler_flags = BENCH_COMPILER_FLAGS,
    linker_flags = STRINGS_BENCH_LINKER_FLAGS,
