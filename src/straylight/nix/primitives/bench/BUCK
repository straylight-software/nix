# src/straylight/nix/primitives/bench/BUCK
#
# URL parsing benchmarks

# Linker flags for benchmark dependencies
BENCH_LINKER_FLAGS = [
    # Ada URL parser
    "-L/nix/store/3b4p38fk6hgwaf2p6jcci5k93b9cnxc8-ada-3.4.1/lib",
    "-lada",
    "-Wl,-rpath,/nix/store/3b4p38fk6hgwaf2p6jcci5k93b9cnxc8-ada-3.4.1/lib",
    # Boost URL
    "-L/nix/store/2izjh733byjickw9719nnkckxd63ghpm-boost-1.87.0/lib",
    "-lboost_url",
    "-Wl,-rpath,/nix/store/2izjh733byjickw9719nnkckxd63ghpm-boost-1.87.0/lib",
    # nanobench
    "-L/nix/store/x5lnx4qwiy1kdlhbnavwqglnlncby1z6-nanobench-4.3.11/lib",
    "-lnanobench",
    "-Wl,-rpath,/nix/store/x5lnx4qwiy1kdlhbnavwqglnlncby1z6-nanobench-4.3.11/lib",
]

# Base compiler flags for benchmarks
BENCH_COMPILER_FLAGS = [
    "-std=c++23",
    "-O3",
    "-DNDEBUG",
    # nanobench header location
    "-isystem/nix/store/x5lnx4qwiy1kdlhbnavwqglnlncby1z6-nanobench-4.3.11/include",
]

# Native arch flags for maximum SIMD performance (Zen 5 / Ryzen 9950X3D)
# Enables AVX-512, AVX-VNNI, and other advanced instruction sets
BENCH_NATIVE_FLAGS = BENCH_COMPILER_FLAGS + [
    "-march=znver5",
    "-mtune=znver5",
]

# ─────────────────────────────────────────────────────────────────────────────
# URL shim library (for benchmarking all three backends)
# ─────────────────────────────────────────────────────────────────────────────
cxx_library(
    name = "url_shim",
    srcs = ["url_shim.cpp"],
    headers = ["url_shim.h"],
    header_namespace = "straylight/nix/primitives/bench",
    compiler_flags = BENCH_COMPILER_FLAGS,
    deps = [
        "//src/straylight/nix/primitives:primitives",
        "//third_party:ada",
        "//third_party:boost",
    ],
    visibility = ["PUBLIC"],
)

# ─────────────────────────────────────────────────────────────────────────────
# URL benchmark executable
# ─────────────────────────────────────────────────────────────────────────────
cxx_binary(
    name = "url_bench",
    srcs = ["url_bench.cpp"],
    compiler_flags = BENCH_COMPILER_FLAGS,
    linker_flags = BENCH_LINKER_FLAGS,
    deps = [
        ":url_shim",
        "//third_party:nanobench",
    ],
)

