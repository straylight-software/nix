# High-quality primitives library with modern C++23

cxx_library(
    name = "primitives",

    srcs = [
        "url.cpp",
        "url_fast.cpp",
    ],

    exported_headers = [
        "config.h",
        "url.h",
        "url_fast.h",
    ],

    header_namespace = "straylight/nix/primitives",

    visibility = ["PUBLIC"],

    compiler_flags = [
        "-std=c++23",
        # Default to ada backend
        "-DSTRAYLIGHT_URL_BACKEND_ADA=1",
    ],

    deps = [
        "//third_party:ada",
    ],
)

