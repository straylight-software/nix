# src/straylight/nix/async/BUCK
#
# Async primitives: work-stealing executor, DAG task graphs, parallel algorithms
# Built on taskflow for modern, efficient parallelism.

# Common compiler flags for all async primitives
COMMON_FLAGS = [
    "-std=c++23",
    "-Wall",
    "-Wextra",
    "-Wpedantic",
]

# ─────────────────────────────────────────────────────────────────────────────
# Executor - work-stealing thread pool with Boehm GC integration
# ─────────────────────────────────────────────────────────────────────────────
cxx_library(
    name = "executor",
    exported_headers = ["executor.h"],
    header_namespace = "straylight/nix/async",
    compiler_flags = COMMON_FLAGS,
    deps = [
        "//third_party:taskflow",
    ],
    # For Boehm GC support, users should link with -lgc and define NIX_USE_BOEHMGC=1
    visibility = ["PUBLIC"],
)

# ─────────────────────────────────────────────────────────────────────────────
# Task Graph - DAG-based task execution (replaces Nix's processGraph)
# ─────────────────────────────────────────────────────────────────────────────
cxx_library(
    name = "task_graph",
    exported_headers = ["task_graph.h"],
    header_namespace = "straylight/nix/async",
    compiler_flags = COMMON_FLAGS,
    deps = [
        "//third_party:taskflow",
    ],
    exported_deps = [
        ":executor",
    ],
    visibility = ["PUBLIC"],
)

# ─────────────────────────────────────────────────────────────────────────────
# Parallel algorithms - parallel_for, reduce, transform, filter
# ─────────────────────────────────────────────────────────────────────────────
cxx_library(
    name = "parallel",
    exported_headers = ["parallel.h"],
    header_namespace = "straylight/nix/async",
    compiler_flags = COMMON_FLAGS,
    deps = [
        "//third_party:taskflow",
    ],
    exported_deps = [
        ":executor",
    ],
    visibility = ["PUBLIC"],
)

# ─────────────────────────────────────────────────────────────────────────────
# Closure - transitive closure computation (replaces Nix's closure.h)
# ─────────────────────────────────────────────────────────────────────────────
cxx_library(
    name = "closure",
    exported_headers = ["closure.h"],
    header_namespace = "straylight/nix/async",
    compiler_flags = COMMON_FLAGS,
    deps = [
        "//third_party:taskflow",
    ],
    exported_deps = [
        ":executor",
    ],
    visibility = ["PUBLIC"],
)

# ─────────────────────────────────────────────────────────────────────────────
# Combined async primitives target
# ─────────────────────────────────────────────────────────────────────────────
cxx_library(
    name = "async",
    exported_headers = [
        "executor.h",
        "task_graph.h",
        "parallel.h",
        "closure.h",
    ],
    header_namespace = "straylight/nix/async",
    compiler_flags = COMMON_FLAGS,
    deps = [
        "//third_party:taskflow",
    ],
    exported_deps = [
        ":executor",
        ":task_graph",
        ":parallel",
        ":closure",
    ],
    visibility = ["PUBLIC"],
)

# ─────────────────────────────────────────────────────────────────────────────
# Variant with Boehm GC support enabled
# ─────────────────────────────────────────────────────────────────────────────
GC_FLAGS = [
    "-DNIX_USE_BOEHMGC=1",
]

GC_LINKER_FLAGS = [
    "-lgc",
]

cxx_library(
    name = "async_gc",
    exported_headers = [
        "executor.h",
        "task_graph.h",
        "parallel.h",
        "closure.h",
    ],
    header_namespace = "straylight/nix/async",
    compiler_flags = COMMON_FLAGS + GC_FLAGS,
    deps = [
        "//third_party:taskflow",
    ],
    linker_flags = GC_LINKER_FLAGS,
    exported_deps = [
        ":executor",
        ":task_graph",
        ":parallel",
        ":closure",
    ],
    visibility = ["PUBLIC"],
)
