# src/straylight/nix/adapters/BUCK
#
# Nix-compatibility adapters for primitives library.
# Provides drop-in replacements for Nix string utilities.

# ─────────────────────────────────────────────────────────────────────────────
# Nix strings adapter (header-only)
# ─────────────────────────────────────────────────────────────────────────────

cxx_library(
    name = "nix_strings_adapter",

    # Header-only library
    srcs = [],

    exported_headers = [
        "nix_strings_adapter.h",
    ],

    header_namespace = "straylight/nix/adapters",

    visibility = ["PUBLIC"],

    compiler_flags = [
        "-std=c++23",
    ],

    # For header-only libraries, transitive deps must be in exported_deps
    exported_deps = [
        "//src/straylight/nix/text:strings",
    ],
)

# Tests moved to //src/straylight/test/unit/adapters
