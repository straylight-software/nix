# src/straylight/nix/fs/BUCK
#
# Filesystem primitives: file locking, memory mapping, temp files/dirs

# Common compiler flags for all filesystem primitives
COMMON_FLAGS = [
    "-std=c++23",
    "-Wall",
    "-Wextra",
    "-Wpedantic",
]

# ─────────────────────────────────────────────────────────────────────────────
# File locking - RAII wrappers around POSIX flock()
# ─────────────────────────────────────────────────────────────────────────────
cxx_library(
    name = "file_lock",
    exported_headers = ["file_lock.h"],
    header_namespace = "straylight/nix/fs",
    compiler_flags = COMMON_FLAGS,
    visibility = ["PUBLIC"],
)

# ─────────────────────────────────────────────────────────────────────────────
# Memory-mapped files - wrapper around mio (vendored header-only lib)
# ─────────────────────────────────────────────────────────────────────────────
cxx_library(
    name = "mmap",
    exported_headers = ["mmap.h"],
    header_namespace = "straylight/nix/fs",
    compiler_flags = COMMON_FLAGS,
    exported_deps = [
        "//third_party:mio",
    ],
    visibility = ["PUBLIC"],
)

# ─────────────────────────────────────────────────────────────────────────────
# Temp files/dirs - RAII wrappers around mkstemp/mkdtemp
# ─────────────────────────────────────────────────────────────────────────────
cxx_library(
    name = "temp",
    exported_headers = ["temp.h"],
    header_namespace = "straylight/nix/fs",
    compiler_flags = COMMON_FLAGS,
    visibility = ["PUBLIC"],
)

# ─────────────────────────────────────────────────────────────────────────────
# Combined filesystem primitives target
# ─────────────────────────────────────────────────────────────────────────────
cxx_library(
    name = "filesystem",
    exported_headers = [
        "file_lock.h",
        "mmap.h",
        "temp.h",
    ],
    header_namespace = "straylight/nix/fs",
    compiler_flags = COMMON_FLAGS,
    exported_deps = [
        ":file_lock",
        ":mmap",
        ":temp",
    ],
    visibility = ["PUBLIC"],
)
