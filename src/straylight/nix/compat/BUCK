# src/straylight/nix/compat/BUCK
#
# External format compatibility: Git, SQLite wrappers

# Common compiler flags
COMMON_FLAGS = [
    "-std=c++23",
    "-Wall",
    "-Wextra",
    "-Wpedantic",
]

# SQLite flags
SQLITE_COMPILER_FLAGS = COMMON_FLAGS + [
    "-isystem/nix/store/yd47pmkv6iv58gs5v5jgyblvkw87pqx3-sqlite-3.50.2/include",
]

SQLITE_LINKER_FLAGS = [
    "-L/nix/store/yd47pmkv6iv58gs5v5jgyblvkw87pqx3-sqlite-3.50.2/lib",
    "-lsqlite3",
    "-Wl,-rpath,/nix/store/yd47pmkv6iv58gs5v5jgyblvkw87pqx3-sqlite-3.50.2/lib",
]

# ─────────────────────────────────────────────────────────────────────────────
# Git - Git format compatibility
# ─────────────────────────────────────────────────────────────────────────────
cxx_library(
    name = "git",
    exported_headers = ["git.h"],
    header_namespace = "straylight/nix/compat",
    compiler_flags = COMMON_FLAGS,
    visibility = ["PUBLIC"],
)

# ─────────────────────────────────────────────────────────────────────────────
# SQLite - RAII wrappers for sqlite3
# ─────────────────────────────────────────────────────────────────────────────
cxx_library(
    name = "sqlite",
    exported_headers = ["sqlite.h"],
    header_namespace = "straylight/nix/compat",
    compiler_flags = SQLITE_COMPILER_FLAGS,
    exported_linker_flags = SQLITE_LINKER_FLAGS,
    deps = [
        "//third_party:sqlite3",
    ],
    visibility = ["PUBLIC"],
)

# ─────────────────────────────────────────────────────────────────────────────
# Combined compat target
# ─────────────────────────────────────────────────────────────────────────────
cxx_library(
    name = "compat",
    exported_headers = [
        "git.h",
        "sqlite.h",
    ],
    header_namespace = "straylight/nix/compat",
    compiler_flags = COMMON_FLAGS,
    exported_deps = [
        ":git",
        ":sqlite",
    ],
    visibility = ["PUBLIC"],
)
