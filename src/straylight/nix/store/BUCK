# src/straylight/nix/store/BUCK
#
# Store implementations: CA store, legacy store, two-tier unified store, log store

# Common compiler flags
COMMON_FLAGS = [
    "-std=c++23",
    "-Wall",
    "-Wextra",
    "-Wpedantic",
]

# ─────────────────────────────────────────────────────────────────────────────
# CA Store - Content-addressed blob storage (coordination-free)
# ─────────────────────────────────────────────────────────────────────────────
cxx_library(
    name = "ca_store",
    srcs = ["ca_store.cpp"],
    exported_headers = ["ca_store.h"],
    header_namespace = "straylight/nix/store",
    compiler_flags = COMMON_FLAGS,
    exported_deps = [
        "//src/straylight/nix/crypto:hash",
        "//vendor:blake3",
    ],
    visibility = ["PUBLIC"],
)

# ─────────────────────────────────────────────────────────────────────────────
# Legacy Store - SQLite-based store for input-addressed paths
# ─────────────────────────────────────────────────────────────────────────────
cxx_library(
    name = "legacy_store",
    srcs = ["legacy_store.cpp"],
    exported_headers = ["legacy_store.h"],
    header_namespace = "straylight/nix/store",
    compiler_flags = COMMON_FLAGS,
    exported_deps = [
        "//src/straylight/nix/sync:lock",
        "//src/straylight/nix/compat:sqlite",
        "//vendor:sqlite",
    ],
    visibility = ["PUBLIC"],
)

# ─────────────────────────────────────────────────────────────────────────────
# Two-Tier Store - Unified CA + Legacy store (header-only facade)
# ─────────────────────────────────────────────────────────────────────────────
cxx_library(
    name = "two_tier_store",
    exported_headers = ["two_tier_store.h"],
    header_namespace = "straylight/nix/store",
    compiler_flags = COMMON_FLAGS,
    exported_deps = [
        ":ca_store",
        ":legacy_store",
    ],
    visibility = ["PUBLIC"],
)

# ─────────────────────────────────────────────────────────────────────────────
# Log Store - Experimental log-structured store
# ─────────────────────────────────────────────────────────────────────────────
cxx_library(
    name = "log_store",
    srcs = ["log_store.cpp"],
    exported_headers = [
        "log_store.h",
        "async.h",
    ],
    header_namespace = "straylight/nix/store",
    compiler_flags = COMMON_FLAGS,
    exported_deps = [
        "//src/straylight/nix/data:serialise",
    ],
    deps = [
        "//src/straylight/nix/crypto:hash",
        "//src/straylight/evring:evring",
        "//vendor:zpp_bits",
        "//vendor:blake3",
    ],
    visibility = ["PUBLIC"],
)

# ─────────────────────────────────────────────────────────────────────────────
# CA Store evring machines - Async I/O handlers
# ─────────────────────────────────────────────────────────────────────────────
cxx_library(
    name = "ca_store_machine",
    exported_headers = ["ca_store_machine.h"],
    header_namespace = "straylight/nix/store",
    compiler_flags = COMMON_FLAGS,
    exported_deps = [
        ":ca_store",
        "//src/straylight/nix/crypto:hash",
        "//src/straylight/evring:evring",
    ],
    visibility = ["PUBLIC"],
)

# ─────────────────────────────────────────────────────────────────────────────
# Combined store target (production two-tier architecture)
# ─────────────────────────────────────────────────────────────────────────────
cxx_library(
    name = "store",
    exported_headers = [
        "ca_store.h",
        "legacy_store.h",
        "two_tier_store.h",
        "ca_store_machine.h",
    ],
    header_namespace = "straylight/nix/store",
    compiler_flags = COMMON_FLAGS,
    exported_deps = [
        ":two_tier_store",
        ":ca_store_machine",
    ],
    visibility = ["PUBLIC"],
)
