# src/straylight/test/integration/BUCK
#
# Integration tests for the nix-language compiler
#
# These tests verify the complete pipeline:
#   Nix source -> parse -> AST -> compile -> WASM -> validate -> execute

COMPILER_FLAGS = ["-std=c++23"]

# Common dependencies for integration tests
INTEGRATION_TEST_DEPS = [
    "//src/straylight/nix/compiler:ast",
    "//src/straylight/nix/compiler:parse",
    "//src/straylight/nix/compiler:compile",
    "//src/straylight/nix/compiler:runtime",
    "//src/straylight/nix/compiler:wasm_executor",
    "//vendor:catch2",
    "//vendor:binaryen",
    "//vendor:wasmtime",
    "//vendor:pegtl",
]

# Full compiler pipeline integration tests
cxx_test(
    name = "compiler_integration_test",
    srcs = ["compiler_integration.cpp"],
    deps = INTEGRATION_TEST_DEPS,
    compiler_flags = COMPILER_FLAGS,
    link_style = "static",
)

# Adversarial input tests - edge cases and malicious inputs
cxx_test(
    name = "compiler_adversarial_test",
    srcs = ["compiler_adversarial.cpp"],
    deps = INTEGRATION_TEST_DEPS,
    compiler_flags = COMPILER_FLAGS,
    link_style = "static",
)

# Brutal stress tests - torture tests for the compiler
cxx_test(
    name = "compiler_brutal_test",
    srcs = ["compiler_brutal.cpp"],
    deps = INTEGRATION_TEST_DEPS,
    compiler_flags = COMPILER_FLAGS,
    link_style = "static",
)

