# // straylight // nix-language // tests
#
# Unit and property-based tests for nix-language module

# Common linker flags for nix-language tests
# NOTE: -L flags MUST come before corresponding -l flags
LANGUAGE_LINKER_FLAGS = [
    # Boost libs (for boost::container::small_vector)
    "-L/nix/store/2izjh733byjickw9719nnkckxd63ghpm-boost-1.87.0/lib",
    "-lboost_container",
    "-Wl,-rpath,/nix/store/2izjh733byjickw9719nnkckxd63ghpm-boost-1.87.0/lib",
    # Test libs
    "-L/nix/store/s4gn9xnjx7298wsxffgxiv3isx0j584k-rapidcheck-0-unstable-2023-12-14/lib",
    "-lrapidcheck",
    "-Wl,-rpath,/nix/store/s4gn9xnjx7298wsxffgxiv3isx0j584k-rapidcheck-0-unstable-2023-12-14/lib",
]

# Common test dependencies
LANGUAGE_TEST_DEPS = [
    "//src/nix-language:ast",
    "//third_party:catch2",
    "//third_party:rapidcheck",
]

LANGUAGE_PARSE_TEST_DEPS = LANGUAGE_TEST_DEPS + [
    "//src/nix-language:parse",
    "//third_party:pegtl",
    "//third_party:boost",
]

LANGUAGE_COMPILE_TEST_DEPS = LANGUAGE_TEST_DEPS + [
    "//src/nix-language:compile",
    "//third_party:binaryen",
]

LANGUAGE_EVAL_TEST_DEPS = LANGUAGE_PARSE_TEST_DEPS + [
    "//src/nix-language:eval",
]

LANGUAGE_TEST_COMPILER_FLAGS = [
    "-std=c++23",
]

# ─────────────────────────────────────────────────────────────────────────────
# AST type tests
# ─────────────────────────────────────────────────────────────────────────────
cxx_test(
    name = "ast_test",
    srcs = ["ast_test.cpp"],
    deps = LANGUAGE_TEST_DEPS,
    compiler_flags = LANGUAGE_TEST_COMPILER_FLAGS,
    linker_flags = LANGUAGE_LINKER_FLAGS,
    link_style = "static",
)

# ─────────────────────────────────────────────────────────────────────────────
# PEGTL grammar tests
