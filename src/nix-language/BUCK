# src/nix-language/BUCK
#
# nix-language: Nix expression parser and WASM compiler
#
# Architecture:
#   Nix source → PEGTL parser → AST → binaryen → WASM module
#
# This is a clean-room implementation designed for AOT compilation,
# not interpretation. The AST types are optimized for WASM codegen.

cxx_library(
    name = "ast",
    exported_headers = [
        "ast/expression.hh",
        "ast/symbol_table.hh",
    ],
    header_namespace = "nix-language",
    visibility = ["PUBLIC"],
    # header-only library, no deps needed
)

cxx_library(
    name = "parse",
    exported_headers = [
        "parse/actions.hh",
        "parse/convert.hh",
        "parse/grammar.hh",
        "parse/lower.hh",
        "parse/parser.hh",
        "parse/selector.hh",
        "parse/state.hh",
        "parse/tree.hh",
    ],
    header_namespace = "nix-language",
    visibility = ["PUBLIC"],
    deps = [
        ":ast",
        "//third_party:pegtl",
        "//third_party:boost",  # for boost::container::small_vector
    ],
)

cxx_library(
    name = "compile",
    exported_headers = [
        "compile/compiler.hh",
        "compile/wasm_types.hh",
    ],
    header_namespace = "nix-language",
    visibility = ["PUBLIC"],
    deps = [
        ":ast",
        "//third_party:binaryen",
    ],
)

cxx_library(
    name = "eval",
    exported_headers = [
        "eval/eval.hh",
        "eval/value.hh",
    ],
    header_namespace = "nix-language",
    visibility = ["PUBLIC"],
    deps = [
        ":ast",
    ],
)

cxx_library(
    name = "runtime",
    srcs = ["runtime/runtime.cpp"],
    exported_headers = [
        "runtime/memory_layout.hh",
        "runtime/runtime.hh",
    ],
    header_namespace = "nix-language",
    visibility = ["PUBLIC"],
    deps = [
        ":compile",  # for wasm_types.hh
    ],
)

# WASM executor using wasmtime
cxx_library(
    name = "wasm_executor",
    srcs = ["runtime/wasm_executor.cpp"],
    exported_headers = [
        "runtime/wasm_executor.hh",
    ],
    header_namespace = "nix-language",
    visibility = ["PUBLIC"],
    compiler_flags = [
        "-std=c++23",
        "-isystem/nix/store/5csjs5zrln4x5y3wxy6pi42bh2816c1s-wasmtime-40.0.0/include",
    ],
    linker_flags = [
        "-L/nix/store/c76a64xqlv5h3i94dzv221pia3pginp1-wasmtime-40.0.0-lib/lib",
        "-lwasmtime",
        "-Wl,-rpath,/nix/store/c76a64xqlv5h3i94dzv221pia3pginp1-wasmtime-40.0.0-lib/lib",
    ],
    exported_deps = [
        ":compile",
        ":runtime",
    ],
    deps = [
        "//third_party:wasmtime",
    ],
)

# main library combining all components
cxx_library(
    name = "language",
    exported_headers = [],
    header_namespace = "nix-language",
    visibility = ["PUBLIC"],
    deps = [
        ":ast",
        ":compile",
        ":eval",
        ":parse",
        ":runtime",
    ],
)

# CLI for evaluating Nix expressions
cxx_binary(
    name = "nix_eval",
    srcs = ["cli/nix_eval.cpp"],
    visibility = ["PUBLIC"],
    deps = [
        ":ast",
        ":eval",
        ":parse",
    ],
)
