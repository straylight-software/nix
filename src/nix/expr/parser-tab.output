Grammar

    0 $accept: start $end

    1 start: expr

    2 expr: expr_function

    3 expr_function: ID ':' expr_function
    4              | formal_set ':' expr_function
    5              | formal_set '@' ID ':' expr_function
    6              | ID '@' formal_set ':' expr_function
    7              | ASSERT expr ';' expr_function
    8              | WITH expr ';' expr_function
    9              | LET binds IN_KW expr_function
   10              | expr_if

   11 expr_if: IF expr THEN expr ELSE expr
   12        | expr_pipe_from
   13        | expr_pipe_into
   14        | expr_op

   15 expr_pipe_from: expr_op PIPE_FROM expr_pipe_from
   16               | expr_op PIPE_FROM expr_op

   17 expr_pipe_into: expr_pipe_into PIPE_INTO expr_op
   18               | expr_op PIPE_INTO expr_op

   19 expr_op: '!' expr_op
   20        | '-' expr_op
   21        | expr_op EQ expr_op
   22        | expr_op NEQ expr_op
   23        | expr_op '<' expr_op
   24        | expr_op LEQ expr_op
   25        | expr_op '>' expr_op
   26        | expr_op GEQ expr_op
   27        | expr_op AND expr_op
   28        | expr_op OR expr_op
   29        | expr_op IMPL expr_op
   30        | expr_op UPDATE expr_op
   31        | expr_op '?' attrpath
   32        | expr_op '+' expr_op
   33        | expr_op '-' expr_op
   34        | expr_op '*' expr_op
   35        | expr_op '/' expr_op
   36        | expr_op CONCAT expr_op
   37        | expr_app

   38 expr_app: expr_app expr_select
   39         | expr_select

   40 expr_select: expr_simple '.' attrpath
   41            | expr_simple '.' attrpath OR_KW expr_select
   42            | expr_simple OR_KW
   43            | expr_simple

   44 expr_simple: ID
   45            | INT_LIT
   46            | FLOAT_LIT
   47            | '"' string_parts '"'
   48            | IND_STRING_OPEN ind_string_parts IND_STRING_CLOSE
   49            | path_start PATH_END
   50            | path_start string_parts_interpolated PATH_END
   51            | SPATH
   52            | URI
   53            | '(' expr ')'
   54            | LET '{' binds '}'
   55            | REC '{' binds '}'
   56            | '{' binds1 '}'
   57            | '{' '}'
   58            | '[' list ']'

   59 string_parts: STR
   60             | string_parts_interpolated
   61             | ε

   62 string_parts_interpolated: string_parts_interpolated STR
   63                          | string_parts_interpolated DOLLAR_CURLY expr '}'
   64                          | DOLLAR_CURLY expr '}'
   65                          | STR DOLLAR_CURLY expr '}'

   66 path_start: PATH
   67           | HPATH

   68 ind_string_parts: ind_string_parts IND_STR
   69                 | ind_string_parts DOLLAR_CURLY expr '}'
   70                 | ε

   71 binds: binds1
   72      | ε

   73 binds1: binds1 attrpath '=' expr ';'
   74       | binds INHERIT attrs ';'
   75       | binds INHERIT '(' expr ')' attrs ';'
   76       | attrpath '=' expr ';'

   77 attrs: attrs attr
   78      | attrs string_attr
   79      | ε

   80 attrpath: attrpath '.' attr
   81         | attrpath '.' string_attr
   82         | attr
   83         | string_attr

   84 attr: ID
   85     | OR_KW

   86 string_attr: '"' string_parts '"'
   87            | DOLLAR_CURLY expr '}'

   88 list: list expr_select
   89     | ε

   90 formal_set: '{' formals ',' ELLIPSIS '}'
   91           | '{' ELLIPSIS '}'
   92           | '{' formals ',' '}'
   93           | '{' formals '}'
   94           | '{' '}'

   95 formals: formals ',' formal
   96        | formal

   97 formal: ID
   98       | ID '?' expr


