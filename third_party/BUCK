filegroup(name = "editline", srcs = [], visibility = ["PUBLIC"])
filegroup(name = "lowdown", srcs = [], visibility = ["PUBLIC"])

# ═══════════════════════════════════════════════════════════════════════════════
# straylight primitives dependencies
# ═══════════════════════════════════════════════════════════════════════════════

# StringZilla - SIMD strings (header-only)
filegroup(name = "stringzilla", srcs = [], visibility = ["PUBLIC"])

# rapidfuzz-cpp - fuzzy matching (header-only)
filegroup(name = "rapidfuzz-cpp", srcs = [], visibility = ["PUBLIC"])

# zpp_bits - binary serialization (header-only)
filegroup(name = "zpp_bits", srcs = [], visibility = ["PUBLIC"])

# taskflow - parallel tasks (header-only)
filegroup(name = "taskflow", srcs = [], visibility = ["PUBLIC"])

# mio - memory mapping (vendored header-only)
cxx_library(
    name = "mio",
    exported_headers = ["mio/mio.hpp"],
    header_namespace = "",
    visibility = ["PUBLIC"],
)

# ═══════════════════════════════════════════════════════════════════════════════
# libevring dependencies (async I/O)
# ═══════════════════════════════════════════════════════════════════════════════

# io_uring wrapper
prebuilt_cxx_library(
    name = "liburing",
    shared_lib = "lib/liburing.so",
    exported_headers = [],
    visibility = ["PUBLIC"],
)

# HTTP/1.x parser
filegroup(name = "llhttp", srcs = [], visibility = ["PUBLIC"])

# HTTP/2
filegroup(name = "nghttp2", srcs = [], visibility = ["PUBLIC"])

# QUIC (LibreSSL backend)
filegroup(name = "ngtcp2", srcs = [], visibility = ["PUBLIC"])

# HTTP/3
filegroup(name = "nghttp3", srcs = [], visibility = ["PUBLIC"])

# ═══════════════════════════════════════════════════════════════════════════════
# nix-language dependencies (WASM)
# ═══════════════════════════════════════════════════════════════════════════════

# PEGTL parser combinators (header-only)
filegroup(name = "pegtl", srcs = [], visibility = ["PUBLIC"])

