# // straylight // nix // third_party
#
# External dependencies.
#
# Static libraries use nix_prebuilt_cxx_library with paths from nix-deps.bzl
# (generated by nix/gen-buck-deps.nix). Header-only and system libs use filegroup stubs.
#
# Regenerate nix-deps.bzl with:
#   nix-build nix/gen-buck-deps.nix -o third_party/nix-deps.bzl

load(
    ":nix-deps.bzl",
    "ABSEIL_INCLUDE",
    # ada now built from vendored source (third_party/ada/BUCK)
    # Binaryen now built from vendored source (vendor/binaryen/BUCK)
    # BLAKE3 now built from vendored source (vendor/blake3/BUCK)
    # Catch2 now built from vendored source (vendor/catch2/BUCK)
    # LibreSSL now built from vendored source (vendor/libressl/BUCK)
    # Boost, brotli, libsodium, libarchive: -L paths from toolchain, just use -l flags
    "MIMALLOC_INCLUDE",
    "MIMALLOC_STATIC_LIB",
    "NANOBENCH_INCLUDE",
    "NANOBENCH_STATIC_LIB",
    "RAPIDCHECK_INCLUDE",
    "RAPIDCHECK_STATIC_LIB",
    "RE2_INCLUDE",
    "RE2_STATIC_LIB",
    "WASMTIME_INCLUDE",
    "WASMTIME_STATIC_LIB",
)
load(":nix_prebuilt.bzl", "nix_prebuilt_cxx_library")

# ═══════════════════════════════════════════════════════════════════════════════
# Performance allocator (linked first to override musl malloc)
# ═══════════════════════════════════════════════════════════════════════════════

# mimalloc - fast allocator that reduces lock contention vs musl's malloc
# Must be linked early to override malloc/free/realloc
nix_prebuilt_cxx_library(
    name = "mimalloc",
    static_lib = MIMALLOC_STATIC_LIB,
    include_dir = MIMALLOC_INCLUDE,
    # Link flags to ensure mimalloc overrides malloc
    exported_linker_flags = ["-Wl,--whole-archive", MIMALLOC_STATIC_LIB, "-Wl,--no-whole-archive"],
)

# ═══════════════════════════════════════════════════════════════════════════════
# nix-util dependencies
# ═══════════════════════════════════════════════════════════════════════════════

filegroup(name = "nlohmann_json", srcs = [], visibility = ["PUBLIC"])  # header-only

# BLAKE3 (vendored, built with Buck2)
# Avoids glibc __memcpy_chk symbols
alias(
    name = "blake3",
    actual = "//vendor/blake3:blake3",
    visibility = ["PUBLIC"],
)

# LibreSSL (vendored, built with Buck2 for full TCB)
alias(
    name = "openssl",  # alias for compatibility
    actual = "//vendor/libressl:crypto",
    visibility = ["PUBLIC"],
)

alias(
    name = "libressl_crypto",
    actual = "//vendor/libressl:crypto",
    visibility = ["PUBLIC"],
)

alias(
    name = "libressl_ssl",
    actual = "//vendor/libressl:ssl",
    visibility = ["PUBLIC"],
)

alias(
    name = "libressl_tls",
    actual = "//vendor/libressl:tls",
    visibility = ["PUBLIC"],
)

alias(
    name = "libressl",
    actual = "//vendor/libressl:libressl",
    visibility = ["PUBLIC"],
)

# Boost static (musl) - multiple libraries
# Note: -L paths are already in toolchain link_flags from flake.nix
# We just need to specify which libs to link
cxx_library(
    name = "boost",
    exported_linker_flags = [
        "-lboost_context",
        "-lboost_iostreams",
        "-lboost_thread",
        "-lboost_url",
    ],
    # Include paths are already in toolchain cxx_flags from flake.nix
    visibility = ["PUBLIC"],
)

# Brotli static (musl)
# -L paths are already in toolchain link_flags
cxx_library(
    name = "brotli",
    exported_linker_flags = [
        "-lbrotlienc",
        "-lbrotlidec",
        "-lbrotlicommon",
    ],
    visibility = ["PUBLIC"],
)

# libsodium static (musl)
# -L paths are already in toolchain link_flags
cxx_library(
    name = "libsodium",
    exported_linker_flags = ["-lsodium"],
    visibility = ["PUBLIC"],
)

# libarchive static (musl)
# -L paths are already in toolchain link_flags
# libarchive depends on: zstd, lzma (xz), bz2, zlib, acl, attr, crypto
cxx_library(
    name = "libarchive",
    exported_linker_flags = [
        "-larchive",
        "-lzstd",      # zstd compression
        "-llzma",      # xz/lzma compression
        "-lbz2",       # bzip2 compression
        "-lz",         # zlib compression
        "-lacl",       # ACL support
        "-lattr",      # extended attributes
        "-lcrypto",    # OpenSSL/LibreSSL crypto (for HMAC)
    ],
    visibility = ["PUBLIC"],
)

# ada URL parser (vendored, built from source)
# Vendored to avoid nixpkgs build issues with fuzzer tests on musl static builds.
alias(
    name = "ada",
    actual = "//third_party/ada:ada",
    visibility = ["PUBLIC"],
)

# Abseil (header-only for Buck2 - libs linked via -l flags)
# Required by RE2 which uses absl::string_view and absl::call_once
cxx_library(
    name = "abseil",
    exported_preprocessor_flags = ["-isystem" + ABSEIL_INCLUDE],
    visibility = ["PUBLIC"],
)

# RE2 regex static (musl)
nix_prebuilt_cxx_library(
    name = "re2",
    static_lib = RE2_STATIC_LIB,
    include_dir = RE2_INCLUDE,
    exported_deps = [":abseil"],
)

