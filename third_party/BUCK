# // straylight // nix // third_party
#
# External dependencies.
#
# Static libraries use nix_prebuilt_cxx_library with paths from nix-deps.bzl
# (generated by nix/gen-buck-deps.nix). Header-only and system libs use filegroup stubs.
#
# Regenerate nix-deps.bzl with:
#   nix-build nix/gen-buck-deps.nix -o third_party/nix-deps.bzl

load(
    ":nix-deps.bzl",
    "ADA_INCLUDE",
    "ADA_STATIC_LIB",
    "BINARYEN_INCLUDE",
    "BINARYEN_STATIC_LIB",
    "BLAKE3_INCLUDE",
    "BLAKE3_STATIC_LIB",
    "LIBRESSL_CRYPTO_LIB",
    "LIBRESSL_INCLUDE",
    "LIBRESSL_SSL_LIB",
    "LIBRESSL_TLS_LIB",
    "NANOBENCH_INCLUDE",
    "NANOBENCH_STATIC_LIB",
    "RAPIDCHECK_INCLUDE",
    "RAPIDCHECK_STATIC_LIB",
    "RE2_INCLUDE",
    "RE2_STATIC_LIB",
)
load(":nix_prebuilt.bzl", "nix_prebuilt_cxx_library")

