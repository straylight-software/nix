# curl static (musl) - minimal build
# Built with: http3Support=false, idnSupport=false, pslSupport=false, scpSupport=false
# -L paths are already in toolchain link_flags
cxx_library(
    name = "curl",
    exported_linker_flags = [
        "-lcurl",
        "-lz",
    ],
    visibility = ["PUBLIC"],
    exported_deps = [
        "//vendor/nghttp2:nghttp2",   # HTTP/2 support
        "//vendor/libressl:ssl",
        "//vendor/libressl:crypto",
    ],
)

# AWS SDK C++ (stub for now - not needed for core nix functionality)
filegroup(name = "aws-sdk-cpp", srcs = [], visibility = ["PUBLIC"])

