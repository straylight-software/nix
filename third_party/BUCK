    name = "binaryen",
    actual = "//vendor/binaryen:binaryen",
    visibility = ["PUBLIC"],
)

# Wasmtime runtime (pre-built static C API from GitHub releases)
# Static linking requires: -lpthread -ldl -lm
nix_prebuilt_cxx_library(
    name = "wasmtime",
    static_lib = WASMTIME_STATIC_LIB,
    include_dir = WASMTIME_INCLUDE,
    exported_linker_flags = ["-lpthread", "-ldl", "-lm"],
)

# ═══════════════════════════════════════════════════════════════════════════════
# nix-protocol dependencies (Kaitai Struct runtime)
# ═══════════════════════════════════════════════════════════════════════════════

cxx_library(
    name = "kaitai",
    srcs = ["kaitai/kaitaistream.cpp"],
    exported_headers = {
        "kaitai/kaitaistruct.h": "kaitai/kaitaistruct.h",
        "kaitai/kaitaistream.h": "kaitai/kaitaistream.h",
        "kaitai/exceptions.h": "kaitai/exceptions.h",
    },
    header_namespace = "",
    visibility = ["PUBLIC"],
    compiler_flags = ["-std=c++17"],
)

