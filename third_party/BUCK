    exported_headers = [],
    visibility = ["PUBLIC"],
)

# Wasmtime runtime
filegroup(name = "wasmtime", srcs = [], visibility = ["PUBLIC"])

# ═══════════════════════════════════════════════════════════════════════════════
# nix-protocol dependencies (Kaitai Struct runtime)
# ═══════════════════════════════════════════════════════════════════════════════

# Kaitai Struct C++ runtime (vendored)
cxx_library(
    name = "kaitai",
    srcs = ["kaitai/kaitaistream.cpp"],
    exported_headers = {
        "kaitai/kaitaistruct.h": "kaitai/kaitaistruct.h",
        "kaitai/kaitaistream.h": "kaitai/kaitaistream.h",
        "kaitai/exceptions.h": "kaitai/exceptions.h",
    },
    header_namespace = "",
    visibility = ["PUBLIC"],
    compiler_flags = ["-std=c++17"],
)

# ═══════════════════════════════════════════════════════════════════════════════
# Test dependencies
# ═══════════════════════════════════════════════════════════════════════════════

prebuilt_cxx_library(
    name = "catch2_lib",
    static_lib = "lib/libCatch2.a",
    exported_headers = [],
    visibility = ["PUBLIC"],
)

prebuilt_cxx_library(
    name = "catch2_main",
    static_lib = "lib/libCatch2Main.a",
    exported_headers = [],
    deps = [":catch2_lib"],
    visibility = ["PUBLIC"],
)

alias(
    name = "catch2",
    actual = ":catch2_main",
    visibility = ["PUBLIC"],
)

prebuilt_cxx_library(
    name = "rapidcheck",
    shared_lib = "lib/librapidcheck.so",
    exported_headers = [],
    visibility = ["PUBLIC"],
)

